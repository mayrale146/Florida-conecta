{
  "name": "florida-conecta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "node --test apps/api/test/*.test.js",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1"
  }
}
